# Azure AD / Entra ID Configuration
# Register an app at: https://portal.azure.com → Entra ID → App registrations
# Redirect URI (SPA): http://localhost:5174
# API permission: Dynamics CRM → user_impersonation

VITE_AZURE_CLIENT_ID=your-app-client-id-here
VITE_AZURE_AUTHORITY=https://login.microsoftonline.com/your-tenant-id-or-common
VITE_REDIRECT_URI=http://localhost:5174

# Azure AI Foundry - Migration-Analyst agent
# Get these from: Azure AI Foundry Portal > Your project > Settings & Endpoints
AZURE_AI_PROJECT_ENDPOINT=https://<your-foundry-host>.services.ai.azure.com/api/projects/<your-project-name>
AZURE_AI_AGENT_ID=Migration-Analyst

# Backend authenticates to Foundry via DefaultAzureCredential
# Easiest: run `az login` on the dev machine
# Production: set service principal env vars or use managed identity
